{
  "name": "mtr-ticketing-workbench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/publish.mjs",
    "build:type": "vue-tsc --noEmit",
    "preview": "vite preview",
    "format": "prettier .. --config .prettierrc.js --ignore-path ../.prettierignore --ignore-unknown --write",
    "format:check": "prettier .. --config .prettierrc.js --ignore-path ../.prettierignore --ignore-unknown --check"
  },
  "dependencies": {
    "pinia": "^3.0.0",
    "sm-crypto": "0.5.7",
    "tdesign-icons-vue-next": "^0.4.4",
    "tdesign-vue-next": "^1.20.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@prettier/plugin-php": "0.26.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "less": "^4.0.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
